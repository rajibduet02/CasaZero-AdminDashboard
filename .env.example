# Public Vite client variables only. These are embedded in the browser bundle.
# Never put Laravel APP_KEY, DB passwords, Firebase Admin JSON, or signing keys here.

# Production Laravel origin (no trailing slash). Dev still uses the Vite /api proxy.
VITE_API_HOST=https://backend.casazero.site

# Firebase web app config (public by design; security is in Firestore/Storage rules).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
